{
    "name": "watercrawl/php",
    "description": "PHP SDK for WaterCrawl REST APIs",
    "type": "library",
    "require": {
        "php": "^7.4 || ^8.0 || ^8.1 || ^8.2 || ^8.3 || ^8.4",
        "guzzlehttp/guzzle": "^7.5",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "license": "MIT",
    "autoload": {
        "files": [
            "src/Polyfill.php"
        ],
        "psr-4": {
            "WaterCrawl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WaterCrawl\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}